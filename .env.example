# Copy to .env.local for local development, and set the same values in
# Vercel → Project Settings → Environment Variables for deployed builds.
#
# Everything here is optional. With nothing set the site builds and runs
# normally; the contact form runs in capture-only mode and writes each
# submission to the server log.

# --- Site URL --------------------------------------------------------------
# Used for canonical URLs, the sitemap, OpenGraph tags, and JSON-LD.
# Set this to the production domain before search engines index the site,
# otherwise every canonical points at the .vercel.app preview host.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Contact form delivery -------------------------------------------------
# All three must be set together. Leave all three unset for capture-only mode.
# A partial configuration is reported as an error rather than silently
# ignored, so the form can never appear to work while dropping enquiries.
#
# RESEND_API_KEY      API key from https://resend.com
# CONTACT_TO_EMAIL    Where enquiries should land
# CONTACT_FROM_EMAIL  A sender address on a domain verified with Resend
#                     (a plain gmail/outlook address will be rejected)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
